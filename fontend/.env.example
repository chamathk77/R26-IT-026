# DEV = local backend | LIVE = DigitalOcean production
EXPO_PUBLIC_APP_ENV=DEV

# Local backend (optional — auto-detected from Expo LAN IP if omitted)
EXPO_PUBLIC_DEV_API_URL=http://192.168.1.6:3000

# Production droplet
EXPO_PUBLIC_LIVE_API_URL=https://168-144-40-49.sslip.io

# Support, bank transfer & billing contact — edit fontend/config/businessContact.json
# Optional overrides (leave blank to use businessContact.json):
# EXPO_PUBLIC_SUPPORT_PHONE=
# EXPO_PUBLIC_SUPPORT_EMAIL=
# EXPO_PUBLIC_BANK_NAME=
# EXPO_PUBLIC_BANK_ACCOUNT_NAME=
# EXPO_PUBLIC_BANK_ACCOUNT_NUMBER=
# EXPO_PUBLIC_BANK_BRANCH=
