PORT=3000
NODE_ENV=development

# APP environment — selects MongoDB database name (overrides path in MONGODB_URI)
# DEV  -> smartCostDev
# LIVE -> smartCostLive
ENV=DEV

# Encode @ in password as %40. DB name in URI is replaced using ENV above.
MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/smartcost?authSource=admin&replicaSet=your-replica-set&tls=true&retryWrites=true&w=majority&appName=SmartCost

# Required for JWT (use a long random string in production)
JWT_SECRET=

# Notify.lk SMS (OTP)
NOTIFY_SMS_API_URL=
NOTIFY_SMS_USER_ID=
NOTIFY_SMS_API_KEY=
NOTIFY_SMS_SENDER_ID=SMARTCOST

# Public base URL for customer digital receipt links (e.g. https://app.smartcost.lk)
DIGITAL_RECEIPT_BASE_URL=

# Daily billing cron — runs at midnight after trial cron when both enabled (Asia/Colombo)
BILLING_CRON_ENABLED=true
BILLING_CRON_SCHEDULE=0 0 * * *
BILLING_CRON_TIMEZONE=Asia/Colombo

# Daily trial cron — expires trials past trailEndDate and clears user tokens
TRIAL_CRON_ENABLED=true
TRIAL_CRON_SCHEDULE=0 0 * * *
TRIAL_CRON_TIMEZONE=Asia/Colombo

# Python Analysis_Backend (FastAPI). Default http://127.0.0.1:8000
# ANALYSIS_SERVICE_URL=http://127.0.0.1:8000
# ANALYSIS_SERVICE_TIMEOUT_MS=25000
