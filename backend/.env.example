PORT=3000

# DEV -> smartCostDev (local) | LIVE -> smartCostLive (production server)
ENV=DEV

# Encode @ in password as %40. DB name in URI is replaced using ENV above.
MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/smartcost?authSource=admin&replicaSet=your-replica-set&tls=true&retryWrites=true&w=majority&appName=SmartCost

# Optional. Overrides the ENV-based database name above (e.g. a research clone).
# MONGODB_DB_NAME=

# Required for JWT (use a long random string in production)
JWT_SECRET=

# Notify.lk SMS (OTP)
NOTIFY_SMS_API_URL=
NOTIFY_SMS_USER_ID=
NOTIFY_SMS_API_KEY=
NOTIFY_SMS_SENDER_ID=SMARTCOST

# Public base URL for customer digital receipt links (SMS)
# LIVE example: https://168-144-40-49.sslip.io
DIGITAL_RECEIPT_BASE_URL=

# Public base URL for uploaded files (receipt images, product photos, etc.)
# LIVE example: https://168-144-40-49.sslip.io
PUBLIC_BASE_URL=

# Public web base URL for the customer QR order pages (Next.js dashboard app).
# Must be reachable from the customer phone — use your LAN IP when testing locally.
CUSTOMER_ORDER_WEB_BASE_URL=

# Daily trial cron — expires trials past trailEndDate and clears user tokens
TRIAL_CRON_ENABLED=true
TRIAL_CRON_SCHEDULE=0 0 * * *
TRIAL_CRON_TIMEZONE=Asia/Colombo

# Daily billing cron — subscription invoice generation (Asia/Colombo)
BILLING_CRON_ENABLED=true
BILLING_CRON_SCHEDULE=0 0 * * *
BILLING_CRON_TIMEZONE=Asia/Colombo

# Daily SMS billing cron — SMS package renewal invoices
SMS_BILL_CRON_ENABLED=true
SMS_BILL_CRON_SCHEDULE=0 0 * * *
SMS_BILL_CRON_TIMEZONE=Asia/Colombo

# Daily due-days cron — subscription payment overdue checks
DUE_DAYS_CRON_ENABLED=true
DUE_DAYS_CRON_SCHEDULE=0 0 * * *
DUE_DAYS_CRON_TIMEZONE=Asia/Colombo

# Daily SMS due-days cron — increment smsDueDays for due/pending; escalate due > 14 to pending
SMS_DUE_DAYS_CRON_ENABLED=true
SMS_DUE_DAYS_CRON_SCHEDULE=0 0 * * *
SMS_DUE_DAYS_CRON_TIMEZONE=Asia/Colombo

# Python analysis backend (FastAPI, see analysis-backend/) — forecasting + customer
# segmentation model fitting. Both novelty features fall back to their JS
# implementation automatically if this is unset or unreachable.
ANALYSIS_SERVICE_URL=http://127.0.0.1:8000
ANALYSIS_SERVICE_TIMEOUT_MS=25000
