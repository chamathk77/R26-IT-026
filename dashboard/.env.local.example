# DEV = local backend | LIVE = DigitalOcean production
NEXT_PUBLIC_APP_ENV=DEV

# Local Express API (default port 3000)
NEXT_PUBLIC_DEV_API_URL=http://localhost:3000

# Production droplet
NEXT_PUBLIC_LIVE_API_URL=https://168-144-40-49.sslip.io

# Optional: force a specific API URL (overrides APP_ENV routing)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Support & bank details: edit dashboard/config/businessContact.json (optional NEXT_PUBLIC_* overrides)
# NEXT_PUBLIC_SUPPORT_PHONE=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_BANK_NAME=
# NEXT_PUBLIC_BANK_ACCOUNT_NAME=
# NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
# NEXT_PUBLIC_BANK_BRANCH=
